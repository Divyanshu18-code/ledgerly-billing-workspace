// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  firstName        String
  lastName         String
  isVerified       Boolean           @default(false)
  resetToken       String?
  resetTokenExp    DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  workspaceMembers WorkspaceMember[]
  auditLogs        AuditLog[]
}

model Workspace {
  id               String            @id @default(uuid())
  name             String
  logoUrl          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  workspaceMembers WorkspaceMember[]
  clients          Client[]
  products         Product[]
  invoices         Invoice[]
  quotations       Quotation[]
  expenses         Expense[]
  taxRates         TaxRate[]
  auditLogs        AuditLog[]
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  MANAGER
  VIEWER
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
}

model Client {
  id             String      @id @default(uuid())
  workspaceId    String
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  email          String
  phone          String?
  taxNumber      String?
  billingAddress Json
  shippingAddress Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  invoices       Invoice[]
  quotations     Quotation[]

  @@unique([workspaceId, email])
}

model Product {
  id             String          @id @default(uuid())
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name           String
  sku            String
  price          Decimal         @db.Decimal(10, 2)
  taxRateId      String?
  taxRate        TaxRate?        @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  description    String?
  isService      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  invoiceItems   InvoiceItem[]
  quotationItems QuotationItem[]

  @@unique([workspaceId, sku])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id            String        @id @default(uuid())
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime
  subTotal      Decimal       @db.Decimal(10, 2)
  taxTotal      Decimal       @db.Decimal(10, 2)
  discountTotal Decimal       @db.Decimal(10, 2)
  grandTotal    Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([workspaceId, invoiceNumber])
}

model InvoiceItem {
  id             String   @id @default(uuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  taxAmount      Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @db.Decimal(10, 2)
  totalAmount    Decimal  @db.Decimal(10, 2)
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

model Quotation {
  id              String          @id @default(uuid())
  workspaceId     String
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  quotationNumber String
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime
  grandTotal      Decimal         @db.Decimal(10, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           QuotationItem[]

  @@unique([workspaceId, quotationNumber])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  unitPrice   Decimal   @db.Decimal(10, 2)
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  UPI
  CASH
}

model Payment {
  id            String        @id @default(uuid())
  workspaceId   String
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  referenceNumber String?
  paymentDate   DateTime
  createdAt     DateTime      @default(now())
}

model Expense {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  amount      Decimal   @db.Decimal(10, 2)
  category    String
  receiptUrl  String?
  expenseDate DateTime
  createdAt   DateTime  @default(now())
}

model TaxRate {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  percentage  Decimal   @db.Decimal(5, 2)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  description String
  createdAt   DateTime  @default(now())
}
