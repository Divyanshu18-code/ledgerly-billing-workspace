generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  passwordHash         String
  firstName            String
  lastName             String
  isVerified           Boolean               @default(false)
  verificationToken    String?
  resetToken           String?
  resetTokenExp        DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  verificationTokenExp DateTime?
  lockUntil            DateTime?
  loginAttempts        Int                   @default(0)
  twoFactorOtp         String?
  twoFactorOtpExp      DateTime?
  twoFactorEnabled     Boolean               @default(false)
  avatar               String?
  phone                String?
  displayName          String?
  jobTitle             String?
  department           String?
  bio                  String?
  dateOfBirth          DateTime?
  gender               String?
  address              String?
  city                 String?
  state                String?
  country              String?               @default("India")
  postalCode           String?
  timezone             String?               @default("UTC")
  language             String?               @default("en")
  theme                String?               @default("system")
  fontSize             String?               @default("medium")
  compactMode          Boolean               @default(false)
  lastLogin            DateTime?
  emailNotifications   Boolean               @default(true)
  pushNotifications    Boolean               @default(true)
  invoiceNotifications Boolean               @default(true)
  paymentNotifications Boolean               @default(true)
  securityAlerts       Boolean               @default(true)
  marketingEmails      Boolean               @default(false)
  profileVisibility    String                @default("public")
  showEmail            Boolean               @default(true)
  showPhone            Boolean               @default(true)
  activityVisibility   Boolean               @default(true)
  auditLogs            AuditLog[]
  createdClients       Client[]              @relation("ClientCreatedBy")
  createdWorkspaces    Workspace[]           @relation("WorkspaceCreatedBy")
  sentInvitations      WorkspaceInvitation[] @relation("InvitedBy")
  workspaceMembers     WorkspaceMember[]
  sessions             Session[]
  userSessions         UserSession[]
  loginHistories       LoginHistory[]
  createdProducts      Product[]             @relation("ProductCreatedBy")
  createdQuotations     Quotation[]           @relation("QuotationCreatedBy")
  createdInvoices       Invoice[]             @relation("InvoiceCreatedBy")
  createdPayments       Payment[]             @relation("PaymentCreatedBy")
  createdExpenses       Expense[]             @relation("ExpenseCreatedBy")
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  activityLogs         ActivityLog[]
  sentEmails           EmailHistory[]        @relation("EmailSentBy")
}

model Workspace {
  id               String                @id @default(uuid())
  name             String
  logoUrl          String?
  gstNumber        String?
  currency         String                @default("INR")
  timezone         String                @default("UTC")
  invoicePrefix    String                @default("INV-")
  address          String?
  phone            String?
  email            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  financialYear    String                @default("2026-2027")
  isArchived       Boolean               @default(false)
  deletedAt        DateTime?
  createdById      String?
  auditLogs        AuditLog[]
  clients          Client[]
  expenses         Expense[]
  vendors          Vendor[]
  expenseCategories ExpenseCategory[]
  invoices         Invoice[]
  payments         Payment[]
  products         Product[]
  quotations       Quotation[]
  taxRates         TaxRate[]
  createdBy        User?                 @relation("WorkspaceCreatedBy", fields: [createdById], references: [id])
  invitations      WorkspaceInvitation[]
  workspaceMembers WorkspaceMember[]
  notifications    Notification[]
  notificationPrefs NotificationPreference[]
  activityLogs     ActivityLog[]
  settings         BusinessSettings?
  emailHistories   EmailHistory[]
  paymentTransactions PaymentTransaction[]
}

model BusinessSettings {
  id                   String     @id @default(uuid())
  workspaceId          String     @unique
  workspace            Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  // Company Profile
  companyName          String     @default("My Business")
  businessType         String?    @default("Private Limited")
  gstNumber            String?
  panNumber            String?
  registrationNumber   String?
  email                String?
  phone                String?
  website              String?
  address              String?
  city                 String?
  state                String?
  country              String?    @default("India")
  postalCode           String?
  
  // Billing Configuration
  invoicePrefix        String     @default("INV-2026-")
  quotationPrefix      String     @default("QT-2026-")
  paymentPrefix        String     @default("PAY-2026-")
  expensePrefix        String     @default("EXP-2026-")
  startingNumber       Int        @default(1001)
  autoIncrement        Boolean    @default(true)
  defaultPaymentTerms  String     @default("Due on Receipt")
  invoiceDueDays       Int        @default(30)
  
  // Localization
  currency             String     @default("INR")
  timezone             String     @default("Asia/Kolkata")
  language             String     @default("English (US)")
  dateFormat           String     @default("DD/MM/YYYY")
  numberFormat         String     @default("Indian Standard")
  firstDayOfWeek       String     @default("Monday")
  
  // Tax
  gstEnabled           Boolean    @default(true)
  defaultGST           Float      @default(18)
  cgst                 Float      @default(9)
  sgst                 Float      @default(9)
  igst                 Float      @default(18)
  taxInclusive         Boolean    @default(false)
  
  // Invoice
  invoiceTemplate      String     @default("Modern Glass")
  footer               String?    @default("Thank you for your business.")
  notes                String?
  terms                String?
  showLogo             Boolean    @default(true)
  showSignature        Boolean    @default(true)
  showQRCode           Boolean    @default(true)
  
  // Notifications
  emailNotifications   Boolean    @default(true)
  browserNotifications Boolean    @default(true)
  invoiceAlerts        Boolean    @default(true)
  paymentAlerts        Boolean    @default(true)
  expenseAlerts        Boolean    @default(false)
  customerAlerts       Boolean    @default(true)
  
  // Branding
  companyLogo          String?
  favicon              String?
  primaryColor         String     @default("#2563eb")
  secondaryColor       String     @default("#1e293b")
  accentColor          String     @default("#10b981")
  
  // Security
  twoFactorEnabled     Boolean    @default(false)
  sessionTimeout       String     @default("60 Minutes")
  autoLogout           Boolean    @default(true)
  
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        Role
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Client {
  id              String       @id @default(uuid())
  workspaceId     String
  name            String
  companyName     String?
  email           String
  phone           String?
  taxNumber       String?
  billingAddress  String?
  shippingAddress String?
  country         String?
  state           String?
  city            String?
  postalCode      String?
  notes           String?
  status          ClientStatus @default(ACTIVE)
  isArchived      Boolean      @default(false)
  deletedAt       DateTime?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdBy       User?        @relation("ClientCreatedBy", fields: [createdById], references: [id])
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
  quotations      Quotation[]
  payments        Payment[]
  paymentTransactions PaymentTransaction[]

  @@unique([workspaceId, email])
}

model Product {
  id             String          @id @default(uuid())
  workspaceId    String
  name           String
  sku            String
  type           ProductType     @default(PRODUCT)
  price          Decimal         @db.Decimal(10, 2)
  purchasePrice  Decimal?        @db.Decimal(10, 2)
  description    String?
  category       String?
  unit           String          @default("pcs")
  hsnSacCode     String?
  taxRateValue   Decimal         @default(0) @db.Decimal(5, 2)
  taxRateId      String?
  status         ProductStatus   @default(ACTIVE)
  isService      Boolean         @default(false)
  isArchived     Boolean         @default(false)
  deletedAt      DateTime?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  invoiceItems   InvoiceItem[]
  taxRate        TaxRate?        @relation(fields: [taxRateId], references: [id])
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation(name: "ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  quotationItems QuotationItem[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, status])
  @@index([workspaceId, type])
}

model Invoice {
  id            String        @id @default(uuid())
  workspaceId   String
  clientId      String
  quotationId   String?
  invoiceNumber String
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("INR")
  notes         String?
  terms         String?
  subTotal      Decimal       @default(0) @db.Decimal(10, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(10, 2)
  discountTotal Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal    Decimal       @default(0) @db.Decimal(10, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(10, 2)
  balanceDue    Decimal       @default(0) @db.Decimal(10, 2)
  isArchived    Boolean       @default(false)
  deletedAt     DateTime?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client           Client        @relation(fields: [clientId], references: [id])
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User?         @relation(name: "InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  quotation        Quotation?    @relation(name: "QuotationToInvoiceLink", fields: [quotationId], references: [id], onDelete: SetNull)
  items            InvoiceItem[]
  payments         Payment[]
  paymentTransactions PaymentTransaction[]
  convertedFrom    Quotation[]   @relation(name: "QuotationConvertedInvoice")

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
}

model InvoiceItem {
  id             String   @id @default(uuid())
  invoiceId      String
  productId      String?
  description    String?
  quantity       Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal  @default(0) @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  taxRateValue   Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Quotation {
  id                 String          @id @default(uuid())
  workspaceId        String
  clientId           String
  quotationNumber    String
  issueDate          DateTime        @default(now())
  validUntil         DateTime
  status             QuotationStatus @default(DRAFT)
  currency           String          @default("INR")
  notes              String?
  terms              String?
  subTotal           Decimal         @default(0) @db.Decimal(10, 2)
  taxTotal           Decimal         @default(0) @db.Decimal(10, 2)
  discountTotal      Decimal         @default(0) @db.Decimal(10, 2)
  grandTotal         Decimal         @default(0) @db.Decimal(10, 2)
  isArchived         Boolean         @default(false)
  deletedAt          DateTime?
  createdById        String?
  convertedInvoiceId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  client           Client          @relation(fields: [clientId], references: [id])
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User?           @relation(name: "QuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  convertedInvoice Invoice?        @relation(name: "QuotationConvertedInvoice", fields: [convertedInvoiceId], references: [id], onDelete: SetNull)
  linkedInvoices   Invoice[]       @relation(name: "QuotationToInvoiceLink")
  items            QuotationItem[]

  @@unique([workspaceId, quotationNumber])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
}

model QuotationItem {
  id             String    @id @default(uuid())
  quotationId    String
  productId      String?
  description    String?
  quantity       Decimal   @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal   @default(0) @db.Decimal(10, 2)
  discountAmount Decimal   @default(0) @db.Decimal(10, 2)
  taxRateValue   Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal   @default(0) @db.Decimal(10, 2)

  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Payment {
  id                   String        @id @default(uuid())
  workspaceId          String
  invoiceId            String
  clientId             String
  paymentNumber        String
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("INR")
  paymentMethod        PaymentMethod @default(CASH)
  paymentDate          DateTime
  transactionReference String?
  notes                String?
  status               PaymentStatus @default(COMPLETED)
  isArchived           Boolean       @default(false)
  deletedAt            DateTime?
  createdById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, paymentNumber])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, status])
  @@index([workspaceId, invoiceId])
  @@index([workspaceId, clientId])
}

model Expense {
  id            String          @id @default(uuid())
  workspaceId   String
  expenseNumber String
  vendorId      String?
  categoryId    String?
  categoryName  String          @default("Miscellaneous")
  amount        Decimal         @db.Decimal(10, 2)
  taxAmount     Decimal         @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal         @default(0) @db.Decimal(10, 2)
  currency      String          @default("INR")
  paymentMethod PaymentMethod   @default(CASH)
  expenseDate   DateTime        @default(now())
  receiptUrl    String?
  notes         String?
  status        ExpenseStatus   @default(PAID)
  isArchived    Boolean         @default(false)
  deletedAt     DateTime?
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vendor    Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  category  ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User?            @relation(name: "ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, expenseNumber])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, status])
  @@index([workspaceId, vendorId])
  @@index([workspaceId, categoryId])
}

model Vendor {
  id            String    @id @default(uuid())
  workspaceId   String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  gstNumber     String?
  address       String?
  notes         String?
  isArchived    Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isArchived])
}

model ExpenseCategory {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  description String?
  color       String?   @default("#3b82f6")
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

enum ExpenseStatus {
  PAID
  PENDING
  REJECTED
  CANCELLED
}

model TaxRate {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  percentage  Decimal   @db.Decimal(5, 2)
  createdAt   DateTime  @default(now())
  products    Product[]
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String?
  action      String
  description String
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  INVOICE_CREATED
  INVOICE_PAID
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  QUOTATION_ACCEPTED
  QUOTATION_REJECTED
  EXPENSE_ADDED
  TEAM_INVITATION
  WORKSPACE_UPDATED
  SYSTEM
}

model Notification {
  id          String           @id @default(uuid())
  workspaceId String
  userId      String
  type        NotificationType @default(SYSTEM)
  title       String
  message     String
  entityId    String?
  entityType  String?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, isRead])
  @@index([workspaceId, createdAt])
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String
  workspaceId        String
  emailNotifications Boolean  @default(true)
  invoiceAlerts      Boolean  @default(true)
  paymentAlerts      Boolean  @default(true)
  quotationAlerts    Boolean  @default(true)
  expenseAlerts      Boolean  @default(true)
  systemAlerts       Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String?
  action      String
  module      String   @default("GENERAL")
  description String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, module])
  @@index([workspaceId, userId])
}

model WorkspaceInvitation {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  role        Role
  token       String    @unique
  invitedById String
  status      String    @default("PENDING")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  MANAGER
  VIEWER
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Session {
  id                String   @id @default(uuid())
  tokenHash         String   @unique
  userId            String
  userAgent         String?
  ipAddress         String?
  deviceName        String?
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revokeReason      String?
  refreshTokenVersion Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum PaymentStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CREDIT_CARD
  DEBIT_CARD
  CHEQUE
  WALLET
  OTHER
}

model EmailHistory {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentType String    // INVOICE, QUOTATION, PAYMENT_REMINDER, THANK_YOU
  documentId   String
  recipient    String
  cc           String?
  bcc          String?
  subject      String
  message      String?
  status       String    @default("SENT") // SENT, FAILED
  createdById  String?
  createdBy    User?     @relation("EmailSentBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PaymentTransaction {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Client?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  gateway       String    // RAZORPAY, STRIPE, MANUAL
  transactionId String    @unique
  orderId       String?
  amount        Decimal   @db.Decimal(10, 2)
  currency      String    @default("INR")
  status        String    @default("COMPLETED") // COMPLETED, PENDING, FAILED, REFUNDED
  paymentMethod String    @default("CARD") // CARD, UPI, NETBANKING, WALLET
  paymentDate   DateTime  @default(now())
  receiptUrl    String?
  failureReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, gateway])
}

model UserSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device      String   @default("Unknown Device")
  browser     String   @default("Unknown Browser")
  os          String   @default("Unknown OS")
  ipAddress   String   @default("127.0.0.1")
  location    String?  @default("Localhost")
  loginTime   DateTime @default(now())
  lastActive  DateTime @default(now())
  isCurrent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    String   @default("Unknown Device")
  browser   String   @default("Unknown Browser")
  os        String   @default("Unknown OS")
  ipAddress String   @default("127.0.0.1")
  location  String?  @default("Localhost")
  status    String   @default("SUCCESS") // SUCCESS, FAILED
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
