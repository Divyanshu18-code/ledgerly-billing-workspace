generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  passwordHash         String
  firstName            String
  lastName             String
  isVerified           Boolean               @default(false)
  verificationToken    String?
  resetToken           String?
  resetTokenExp        DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  verificationTokenExp DateTime?
  lockUntil            DateTime?
  loginAttempts        Int                   @default(0)
  auditLogs            AuditLog[]
  createdClients       Client[]              @relation("ClientCreatedBy")
  createdWorkspaces    Workspace[]           @relation("WorkspaceCreatedBy")
  sentInvitations      WorkspaceInvitation[] @relation("InvitedBy")
  workspaceMembers     WorkspaceMember[]
  sessions             Session[]
  createdProducts      Product[]             @relation("ProductCreatedBy")
  createdQuotations     Quotation[]           @relation("QuotationCreatedBy")
}

model Workspace {
  id               String                @id @default(uuid())
  name             String
  logoUrl          String?
  gstNumber        String?
  currency         String                @default("USD")
  timezone         String                @default("UTC")
  invoicePrefix    String                @default("INV-")
  address          String?
  phone            String?
  email            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  financialYear    String                @default("2026-2027")
  isArchived       Boolean               @default(false)
  deletedAt        DateTime?
  createdById      String?
  auditLogs        AuditLog[]
  clients          Client[]
  expenses         Expense[]
  invoices         Invoice[]
  products         Product[]
  quotations       Quotation[]
  taxRates         TaxRate[]
  createdBy        User?                 @relation("WorkspaceCreatedBy", fields: [createdById], references: [id])
  invitations      WorkspaceInvitation[]
  workspaceMembers WorkspaceMember[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        Role
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Client {
  id              String       @id @default(uuid())
  workspaceId     String
  name            String
  companyName     String?
  email           String
  phone           String?
  taxNumber       String?
  billingAddress  String?
  shippingAddress String?
  country         String?
  state           String?
  city            String?
  postalCode      String?
  notes           String?
  status          ClientStatus @default(ACTIVE)
  isArchived      Boolean      @default(false)
  deletedAt       DateTime?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdBy       User?        @relation("ClientCreatedBy", fields: [createdById], references: [id])
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
  quotations      Quotation[]

  @@unique([workspaceId, email])
}

model Product {
  id             String          @id @default(uuid())
  workspaceId    String
  name           String
  sku            String
  type           ProductType     @default(PRODUCT)
  price          Decimal         @db.Decimal(10, 2)
  purchasePrice  Decimal?        @db.Decimal(10, 2)
  description    String?
  category       String?
  unit           String          @default("pcs")
  hsnSacCode     String?
  taxRateValue   Decimal         @default(0) @db.Decimal(5, 2)
  taxRateId      String?
  status         ProductStatus   @default(ACTIVE)
  isService      Boolean         @default(false)
  isArchived     Boolean         @default(false)
  deletedAt      DateTime?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  invoiceItems   InvoiceItem[]
  taxRate        TaxRate?        @relation(fields: [taxRateId], references: [id])
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation(name: "ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  quotationItems QuotationItem[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, status])
  @@index([workspaceId, type])
}

model Invoice {
  id            String        @id @default(uuid())
  workspaceId   String
  clientId      String
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime
  subTotal      Decimal       @db.Decimal(10, 2)
  taxTotal      Decimal       @db.Decimal(10, 2)
  discountTotal Decimal       @db.Decimal(10, 2)
  grandTotal    Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        Client        @relation(fields: [clientId], references: [id])
  workspace     Workspace     @relation(fields: [workspaceId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([workspaceId, invoiceNumber])
}

model InvoiceItem {
  id             String  @id @default(uuid())
  invoiceId      String
  productId      String
  quantity       Int
  unitPrice      Decimal @db.Decimal(10, 2)
  taxAmount      Decimal @db.Decimal(10, 2)
  discountAmount Decimal @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
}

model Quotation {
  id                 String          @id @default(uuid())
  workspaceId        String
  clientId           String
  quotationNumber    String
  issueDate          DateTime        @default(now())
  validUntil         DateTime
  status             QuotationStatus @default(DRAFT)
  currency           String          @default("USD")
  notes              String?
  terms              String?
  subTotal           Decimal         @default(0) @db.Decimal(10, 2)
  taxTotal           Decimal         @default(0) @db.Decimal(10, 2)
  discountTotal      Decimal         @default(0) @db.Decimal(10, 2)
  grandTotal         Decimal         @default(0) @db.Decimal(10, 2)
  isArchived         Boolean         @default(false)
  deletedAt          DateTime?
  createdById        String?
  convertedInvoiceId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  client             Client          @relation(fields: [clientId], references: [id])
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy          User?           @relation(name: "QuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items              QuotationItem[]

  @@unique([workspaceId, quotationNumber])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
}

model QuotationItem {
  id             String    @id @default(uuid())
  quotationId    String
  productId      String?
  description    String?
  quantity       Decimal   @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal   @default(0) @db.Decimal(10, 2)
  discountAmount Decimal   @default(0) @db.Decimal(10, 2)
  taxRateValue   Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal   @default(0) @db.Decimal(10, 2)

  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(uuid())
  workspaceId     String
  invoiceId       String
  amount          Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  referenceNumber String?
  paymentDate     DateTime
  createdAt       DateTime      @default(now())
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
}

model Expense {
  id          String    @id @default(uuid())
  workspaceId String
  amount      Decimal   @db.Decimal(10, 2)
  category    String
  receiptUrl  String?
  expenseDate DateTime
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model TaxRate {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  percentage  Decimal   @db.Decimal(5, 2)
  createdAt   DateTime  @default(now())
  products    Product[]
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String?
  action      String
  description String
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceInvitation {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  role        Role
  token       String    @unique
  invitedById String
  status      String    @default("PENDING")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  MANAGER
  VIEWER
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Session {
  id                String   @id @default(uuid())
  tokenHash         String   @unique
  userId            String
  userAgent         String?
  ipAddress         String?
  deviceName        String?
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revokeReason      String?
  refreshTokenVersion Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  UPI
  CASH
}
